{
	"name": "@temelyos/eslint-plugin-i18n",
	"version": "1.0.0",
	"description": "Lint rules for i18n: flags untranslated user-facing strings in JSX",
	"author": "Secure Data Systems",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/temelyos/tooling.git",
		"directory": "packages/eslint-plugin-i18n"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"./dist",
		"./LICENSE",
		"./package.json",
		"./README.md"
	],
	"scripts": {
		"build": "node ../../scripts/build.mjs && tsc --project tsconfig.build.json",
		"deploy": "npm run build && node ../../scripts/publish.mjs",
		"lint": "oxlint -c ../../oxlint.config.mts",
		"lint:fix": "temelyos-oxlint-fix -c ../../oxlint.config.mts",
		"test": "node --import tsx --test \"src/**/*.spec.ts\"",
		"type-check": "tsc --noEmit --project tsconfig.json"
	},
	"dependencies": {
		"@typescript-eslint/utils": "catalog:eslint"
	},
	"devDependencies": {
		"@oxlint/plugins": "catalog:oxlint",
		"@temelyos/tsconfig": "workspace:^",
		"oxlint": "catalog:oxlint",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	}
}
