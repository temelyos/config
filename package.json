{
	"name": "@temelyos/tooling",
	"packageManager": "pnpm@10.25.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/temelyos/tooling.git"
	},
	"scripts": {
		"build": "turbo run build",
		"clean": "node scripts/clean.mjs",
		"deploy": "npm run deploy:tsconfig && npm run deploy:eslint-config && npm run deploy:oxlint-config && npm run deploy:eslint-plugin-i18n",
		"deploy:eslint-config": "cd packages/eslint-config && npm run deploy",
		"deploy:eslint-plugin-i18n": "cd packages/eslint-plugin-i18n && npm run deploy",
		"deploy:oxlint-config": "cd packages/oxlint-config && npm run deploy",
		"deploy:tsconfig": "cd packages/tsconfig && npm run deploy",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"prune": "node scripts/prune.mjs",
		"test": "turbo run test",
		"type-check": "turbo run type-check"
	},
	"devDependencies": {
		"@temelyos/oxlint-config": "workspace:^",
		"@types/node": "catalog:node",
		"oxlint": "catalog:oxlint",
		"oxlint-tsgolint": "catalog:oxlint",
		"tsx": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
