{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
    "lint": {
      "dependsOn": ["@temelyos/oxlint-config#build"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["@temelyos/oxlint-config#build"],
      "outputs": []
    }
	}
}